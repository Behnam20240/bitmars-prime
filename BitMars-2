<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BitMars Prime</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: radial-gradient(circle at top, #25204f, #0b0b18 65%);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .app {
      width: 100%;
      max-width: 430px;
      min-height: 100vh;
      padding: 25px 20px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .header {
      margin-top: 15px;
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
      letter-spacing: 2px;
    }

    .subtitle {
      margin-top: 6px;
      color: #aaa;
      font-size: 13px;
    }

    .score-box {
      margin-top: 35px;
    }

    .score {
      font-size: 42px;
      font-weight: bold;
    }

    .coin-name {
      color: #aaa;
      font-size: 14px;
      margin-top: 5px;
    }

    .coin-button {
      width: 220px;
      height: 220px;
      margin: 35px auto;
      border-radius: 50%;
      border: 8px solid rgba(255,255,255,0.15);
      background: radial-gradient(circle, #ffe77a 0%, #f5b82e 55%, #b66b08 100%);
      box-shadow:
        0 0 30px rgba(255, 210, 70, 0.45),
        inset 0 0 25px rgba(255,255,255,0.4);
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 70px;
      cursor: pointer;
      user-select: none;
      transition: transform 0.08s;
    }

    .coin-button:active {
      transform: scale(0.93);
    }

    .tap-text {
      font-size: 18px;
      font-weight: bold;
    }

    .stats {
      display: flex;
      justify-content: space-around;
      background: rgba(255,255,255,0.07);
      border-radius: 18px;
      padding: 16px 8px;
      margin-bottom: 20px;
    }

    .stat-number {
      font-size: 20px;
      font-weight: bold;
    }

    .stat-label {
      color: #999;
      font-size: 11px;
      margin-top: 4px;
    }

    .plus {
      position: fixed;
      font-size: 28px;
      font-weight: bold;
      pointer-events: none;
      animation: floatUp 0.7s ease-out forwards;
    }

    @keyframes floatUp {
      0% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      100% {
        opacity: 0;
        transform: translateY(-90px) scale(1.3);
      }
    }
  </style>
</head>

<body>

  <div class="app">

    <div>
      <div class="header">
        <div class="logo">BITMARS PRIME 🚀</div>
        <div class="subtitle">Digital Currency Beyond Earth</div>
      </div>

      <div class="score-box">
        <div class="score" id="score">0</div>
        <div class="coin-name">BMP COINS</div>
      </div>

      <div
        class="coin-button"
        id="coin"
        onclick="tapCoin(event)">
        🪙
      </div>

      <div class="tap-text">TAP TO MINE</div>
    </div>

    <div class="stats">
      <div>
        <div class="stat-number" id="taps">0</div>
        <div class="stat-label">TOTAL TAPS</div>
      </div>

      <div>
        <div class="stat-number">+1</div>
        <div class="stat-label">PER TAP</div>
      </div>

      <div>
        <div class="stat-number">BMP</div>
        <div class="stat-label">TOKEN</div>
      </div>
    </div>

  </div>

  <script>

    let score = Number(localStorage.getItem("bmp_score")) || 0;
    let taps = Number(localStorage.getItem("bmp_taps")) || 0;

    const scoreElement = document.getElementById("score");
    const tapsElement = document.getElementById("taps");

    function updateScreen() {
      scoreElement.textContent = score.toLocaleString();
      tapsElement.textContent = taps.toLocaleString();
    }

    function tapCoin(event) {

      score++;
      taps++;

      localStorage.setItem("bmp_score", score);
      localStorage.setItem("bmp_taps", taps);

      updateScreen();

      const plus = document.createElement("div");

      plus.className = "plus";
      plus.textContent = "+1";

      plus.style.left = event.clientX + "px";
      plus.style.top = event.clientY + "px";

      document.body.appendChild(plus);

      setTimeout(() => {
        plus.remove();
      }, 700);
    }

    updateScreen();

  </script>

</body>
</html>